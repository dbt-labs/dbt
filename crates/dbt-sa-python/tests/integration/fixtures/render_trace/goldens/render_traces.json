    "rendered": "\n\n\n\n\n\nwith source_events as (\n    select *\n    from \"raw\".\"events\"\n    \n),\n\nbase_values as (\n    select * from __dbt__cte__base\n),\n\nrenamed as (\n    select\n        event_id,\n        \"account_id\" as account_id,\n        \"event_type\" as event_type,\n        event_timestamp,\n        'dev' as dbt_target,\n        7 as trace_version\n    from source_events\n)\n\nselect renamed.*, base_values.base_value\nfrom renamed\ncross join base_values",
    "source": "{{ config(\n    materialized='incremental',\n    unique_key='event_id',\n    tags=['render-trace', target.name]\n) }}\n\n{# Common package-style setup: project vars, list construction, and dispatch. #}\n{% set dimensions = var('render_trace_columns', ['account_id']) %}\n{% set include_audit = var('include_audit_columns', false) %}\n\nwith source_events as (\n    select *\n    from {{ source('raw', 'events') }}\n    {% if is_incremental() %}\n    where updated_at > (select max(updated_at) from {{ this }})\n    {% endif %}\n),\n\nbase_values as (\n    select * from {{ ref('base') }}\n),\n\nrenamed as (\n    select\n        event_id,\n        {%- for column in dimensions %}\n        {{ adapter.dispatch('trace_column', 'render_trace')(column) }} as {{ column }},\n        {%- endfor %}\n        event_timestamp\n        {%- if include_audit %},\n        '{{ target.name }}' as dbt_target,\n        {{ probe_value(7) }} as trace_version\n        {%- endif %}\n    from source_events\n)\n\nselect renamed.*, base_values.base_value\nfrom renamed\ncross join base_values\n",
    "source_path": "models/common_patterns.sql",
