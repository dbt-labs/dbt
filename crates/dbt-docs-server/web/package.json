{
  "name": "dbt-docs-web",
  "version": "0.0.0",
  "description": "The dbt docs v2 SPA embedded in the dbt binary by dbt-docs-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/watch.mjs \"vite serve\"",
    "build": "node scripts/build-deps.mjs && tsc && vite build",
    "build:watch": "node scripts/watch.mjs \"vite build --watch\"",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "node scripts/build-deps.mjs && tsc --noEmit",
    "test": "node scripts/build-deps.mjs && vitest run --project unit",
    "test:watch": "node scripts/watch.mjs \"vitest watch --project unit\"",
    "test:stories": "node scripts/build-deps.mjs && vitest run --project storybook",
    "test:all": "node scripts/build-deps.mjs && vitest run",
    "test:duckdb-browser": "node scripts/build-deps.mjs && tsc --noEmit --strict --skipLibCheck --module esnext --moduleResolution bundler --target es2022 --lib es2022,dom tests/duckdb-consumer.ts && node tests/duckdb-browser.mjs",
    "storybook": "node scripts/watch.mjs \"storybook dev -p 6006\"",
    "build-storybook": "node scripts/build-deps.mjs && storybook build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@dagrejs/dagre": "^3.1.3",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^8.21.3",
    "@uidotdev/usehooks": "^2.4.1",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dbt-docs-lib": "workspace:*",
    "hyparquet": "^1.33.0",
    "hyparquet-compressors": "^1.1.3",
    "lodash": "^4.17.21",
    "lucide-react": "^1.73.0",
    "pretty-bytes": "^6.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.6.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.18.5",
    "rehype-external-links": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^2.2.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "autoprefixer": "^10.6.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^21.0.4",
    "playwright": "1.65.1",
    "postcss": "^8.5.33",
    "storybook": "10.6.7",
    "tailwindcss": "^3.4.0",
    "typescript": "5.9.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
