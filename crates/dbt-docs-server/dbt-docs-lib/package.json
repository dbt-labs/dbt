    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "storybook": "10.5.10",
    "tailwindcss": "^3.4.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.28.0",
    "unplugin-dts": "^1.1.1",
    "vite": "^6.3.3",
    "vitest": "^3.0.9",
    "vite-plugin-lib-inject-css": "^2.2.2"
  }
